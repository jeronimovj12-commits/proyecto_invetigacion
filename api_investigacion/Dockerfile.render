FROM python:3.12-slim
WORKDIR /app
COPY api_investigacion/requirements-v3.lock ./requirements-v3.lock
RUN pip install --no-cache-dir -r requirements-v3.lock
COPY api_investigacion/ ./
COPY db/ /db/
EXPOSE 10000
CMD ["sh", "-c", "python comandos/preparar_render.py && uvicorn main_v3:app --host 0.0.0.0 --port ${PORT:-10000}"]
